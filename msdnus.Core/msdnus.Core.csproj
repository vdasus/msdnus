<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <OutputType>Library</OutputType>
    <DefaultLanguage>en-US</DefaultLanguage>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Properties\msdnus.Core.rd.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="KindOfMagic" Version="1.3.1" />
    <PackageReference Include="Lex.Db" Version="1.2.6" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250114003" />
  </ItemGroup>

  <PropertyGroup>
    <PreBuildEvent>if $(ConfigurationName) == Release "$(SolutionDir)external\vbinc2" -v0010 -p"$(ProjectDir)Properties\AssemblyInfo.cs"</PreBuildEvent>
  </PropertyGroup>
</Project>