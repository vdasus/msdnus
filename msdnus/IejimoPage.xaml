<Page
    x:Class="msdnus.IejimoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:msdnus"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="IejimoPage_OnLoaded"
    DataContext="{Binding Source={StaticResource Locator}, Path=Iejimo}">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel Height="Auto" Grid.Row="0" Orientation="Horizontal" Margin="10 0 0 10">
            <TextBlock x:Uid="appname" Style="{ThemeResource HeaderTextBlockStyle}" />
        </StackPanel>
        <PasswordBox x:Uid="enterpin" HorizontalContentAlignment="Center" x:Name="passwordBox" HorizontalAlignment="Left" Margin="69,82,0,0" 
                     VerticalAlignment="Top" Width="222" Password="" PasswordChanged="PasswordChangedHandler"
                     PreventKeyboardDisplayOnProgrammaticFocus="False">
            <PasswordBox.InputScope>
                <InputScope>
                    <InputScope.Names>
                        <InputScopeName NameValue="NumericPin"/>
                    </InputScope.Names>
                </InputScope>
            </PasswordBox.InputScope>
        </PasswordBox>
    </Grid>
</Page>
