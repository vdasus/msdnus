<Page
    x:Class="msdnus.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    
    <Grid Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <SplitView x:Name="Splitter" Grid.Row="0" IsPaneOpen="{x:Bind Vm.IsIejimoMode, Mode=OneWay}" 
                   PanePlacement="Left" PaneClosing="Splitter_OnPaneClosing">
            <SplitView.Pane>
                <RelativePanel Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
                    <PasswordBox Visibility="{x:Bind Vm.IsIejimoMode, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                        x:Uid="enterpin" HorizontalContentAlignment="Center" x:Name="PasswordBox" HorizontalAlignment="Left" Margin="68,80,0,0" 
                                 VerticalAlignment="Top" Width="220" Password="" PasswordChanged="PasswordChangedHandler"
                                 InputScope="NumericPin" />
                    <Button Margin="4" Style="{ThemeResource TextBlockButtonStyle}"
                                     RelativePanel.Below="PasswordBox" 
                                     RelativePanel.AlignRightWith="PasswordBox" 
                            Command="{x:Bind Vm.ResetIejimoPwdCommand, Mode=OneTime}">
                        <TextBlock TextAlignment="Right" x:Uid="resetiej" TextWrapping="WrapWholeWords" />
                    </Button>
                </RelativePanel>
            </SplitView.Pane>
            
            <RelativePanel Visibility="{x:Bind Vm.IsIejimoMode, Mode=OneWay, Converter={StaticResource InvBoolToVisConverter}}">
                <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="48" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    
                    <TextBlock x:Uid="appname" Grid.Row="0" Style="{ThemeResource HeaderTextBlockStyle}" Height="Auto" Margin="8 0 0 8" />

                    <TextBox x:Uid="srctxt" Grid.Row="1" Text="{x:Bind Vm.TextToSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 TextChanged="TextBox_OnTextChanged" 
                                 HorizontalAlignment="Left" Margin="4" VerticalAlignment="Top" MinWidth="248" />
                                 
                    <ScrollViewer Grid.Row="2">
                        <ListBox x:Uid="Log2" ItemsSource="{x:Bind Vm.DataItems, Mode=OneWay}" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"></RowDefinition>
                                            <RowDefinition Height="Auto"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Name, Mode=OneTime}" Style="{ThemeResource BodyTextBlockStyle}" Grid.Row="0" />
                                        <ItemsControl ItemsSource="{Binding Items, Mode=OneTime}" Grid.Row="1">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <AppBarButton 
                                                                x:Uid="butcopy"
                                                                Icon="Copy" 
                                                                IsCompact="True"
                                                                Command="{Binding DataContext.CopyToClipboardCommand, ElementName=Splitter, Mode=OneTime}"
                                                                CommandParameter="{Binding Value, Mode=OneTime}" />
                                                        <TextBlock x:Uid="lbval" Text="{Binding Value, Mode=OneTime}" 
                                                                       Style="{ThemeResource BaseTextBlockStyle}" VerticalAlignment="Center" 
                                                                   Margin="4 0 0 4" />
                                                        <TextBlock x:Uid="lbtyp" ToolTipService.ToolTip="" Text="{Binding Type, Mode=OneTime}" 
                                                                       Style="{ThemeResource BodyTextBlockStyle}" VerticalAlignment="Center" 
                                                                   Margin="4 0 0 4" />
                                                        <TextBlock x:Uid="lbcdt" ToolTipService.ToolTip="" Text="{Binding ClaimedDate, Mode=OneTime}" 
                                                                       Style="{ThemeResource BodyTextBlockStyle}" VerticalAlignment="Center" 
                                                                   Margin="4 0 0 4" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </RelativePanel>
        </SplitView>
        
        <CommandBar Grid.Row="1" Visibility="{x:Bind Vm.IsIejimoMode, Mode=OneWay, Converter={StaticResource InvBoolToVisConverter}}">
            <AppBarButton x:Uid="lockbutton" Icon="Permissions" Command="{x:Bind Vm.LockAllCommand, Mode=OneTime}"/>
            <AppBarButton x:Uid="fromonedrbutton" Icon="Globe" Command="{x:Bind Vm.LoadFromOneDriveCommand, Mode=OneTime}"/>
            <AppBarButton x:Uid="loadbutton" Icon="Download" Command="{x:Bind Vm.GetFromFilePickerCommand, Mode=OneTime}"/>
            <AppBarButton x:Uid="helpbutton" Icon="Help" Command="{x:Bind Vm.NavigateToHelpCommand, Mode=OneTime}" />
            <CommandBar.SecondaryCommands>
                <AppBarButton x:Uid="likebutton" Icon="Like" Command="{x:Bind Vm.NavigateToCoffeeCupCommand, Mode=OneTime}" />
                <AppBarButton x:Uid="settingsbutton" Icon="Setting" Command="{x:Bind Vm.NavigateToSettingsCommand, Mode=OneTime}" />
                <AppBarButton x:Uid="aboutbutton" Icon="Contact" Command="{x:Bind Vm.NavigateToAboutCommand, Mode=OneTime}" />
            </CommandBar.SecondaryCommands>
            <CommandBar.Content>
                <StackPanel>
                    <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}" MinWidth="248" Margin="4"/>
                    <ProgressBar IsIndeterminate="True" Visibility="{x:Bind Vm.IsProgress, Mode=OneWay}" />
                </StackPanel>
            </CommandBar.Content>
        </CommandBar>
    </Grid>
</Page>