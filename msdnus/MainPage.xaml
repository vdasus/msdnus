<Page
    x:Class="msdnus.MainPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="using:msdnus.Core.Model"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (drag region) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="8">
                <FontIcon Glyph="&#xE8D7;" FontSize="16" />
                <TextBlock Text="msdnus" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ======================= Main area ======================= -->
        <Grid Grid.Row="1" Visibility="{x:Bind Vm.IsUnlocked, Mode=OneWay}" Padding="24,4,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Command row: search + actions -->
            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="560" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <AutoSuggestBox
                    x:Name="SearchBox"
                    x:Uid="SearchBox"
                    Grid.Column="0"
                    QueryIcon="Find"
                    Text="{x:Bind Vm.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    KeyDown="SearchBox_OnKeyDown" />

                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind Vm.ResultsSummary, Mode=OneWay}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                    <Button x:Name="ImportFileButton" Command="{x:Bind Vm.ImportFromFileCommand}" Style="{ThemeResource DefaultButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                            <TextBlock x:Uid="ImportFileLabel" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ImportOneDriveButton" x:Uid="ImportOneDriveButton" Command="{x:Bind Vm.ImportFromOneDriveCommand}">
                        <FontIcon Glyph="&#xE753;" FontSize="16" />
                    </Button>
                    <Button x:Name="SettingsButton" x:Uid="SettingsButton" Click="SettingsButton_OnClick">
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                    </Button>
                    <Button x:Name="AboutButton" x:Uid="AboutButton">
                        <FontIcon Glyph="&#xE946;" FontSize="16" />
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Spacing="4" MinWidth="220">
                                    <TextBlock Text="msdnus" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="VersionText" Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Uid="AboutDescription" Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="© vdasus" Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="LockButton" x:Uid="LockButton" Command="{x:Bind Vm.LockCommand}">
                        <FontIcon Glyph="&#xE72E;" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>

            <ProgressBar Grid.Row="1" IsIndeterminate="True" Margin="0,8,0,0"
                         Visibility="{x:Bind Vm.IsBusy, Mode=OneWay}" />

            <!-- Product list -->
            <ListView
                Grid.Row="2"
                Margin="0,12,0,0"
                ItemsSource="{x:Bind Vm.Products, Mode=OneWay}"
                SelectionMode="None"
                IsItemClickEnabled="False">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="model:YourKeyDTO">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{x:Bind Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="model:YourKeyKeyDTO">
                                            <Button
                                                Margin="0,2,0,0"
                                                Padding="8,6"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                Command="{Binding ElementName=RootPage, Path=Vm.CopyKeyCommand}"
                                                CommandParameter="{x:Bind}">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Grid.Column="0" Glyph="&#xE8C8;" FontSize="14"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Value}"
                                                               FontFamily="Consolas" FontSize="15"
                                                               VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Type}"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                        <TextBlock Text="{x:Bind ClaimedDate}"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Empty state (empty database, not empty search results) -->
            <StackPanel
                Grid.Row="2"
                Visibility="{x:Bind Vm.ShowEmptyState, Mode=OneWay}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Spacing="12" MaxWidth="420">
                <FontIcon Glyph="&#xE8D7;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock x:Uid="EmptyTitle" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock x:Uid="EmptyHint" Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" TextAlignment="Center" />
                <Button x:Uid="EmptyImportButton" Command="{x:Bind Vm.ImportFromFileCommand}"
                        Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ======================= Lock overlay ======================= -->
        <Grid Grid.Row="1" Visibility="{x:Bind Vm.IsLocked, Mode=OneWay}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Width="280">
                <FontIcon Glyph="&#xE72E;" FontSize="48" HorizontalAlignment="Center" />
                <TextBlock Text="msdnus" Style="{ThemeResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
                <PasswordBox
                    x:Name="PinBox"
                    x:Uid="PinBox"
                    InputScope="NumericPin"
                    HorizontalContentAlignment="Center"
                    PasswordChanged="PinBox_OnPasswordChanged" />
                <HyperlinkButton x:Uid="ResetPinButton" Command="{x:Bind Vm.ResetPinCommand}"
                                 HorizontalAlignment="Center" FontSize="12" />
            </StackPanel>
        </Grid>

        <!-- Bottom feedback -->
        <InfoBar
            Grid.Row="2"
            Margin="24,8,24,16"
            IsOpen="{x:Bind Vm.IsInfoOpen, Mode=OneWay}"
            Message="{x:Bind Vm.InfoMessage, Mode=OneWay}"
            Severity="{x:Bind Vm.InfoSeverity, Mode=OneWay}"
            IsClosable="False" />

        <!-- Settings dialog -->
        <ContentDialog
            x:Name="SettingsDialog"
            x:Uid="SettingsDialog"
            DefaultButton="Primary"
            PrimaryButtonClick="SettingsDialog_OnPrimaryButtonClick">
            <StackPanel Spacing="16" MinWidth="300">
                <ToggleSwitch x:Name="ThemeToggle" x:Uid="ThemeToggle"
                              IsOn="{x:Bind Vm.IsDarkTheme, Mode=TwoWay}" />
                <PasswordBox x:Name="NewPin1" x:Uid="NewPin1" InputScope="NumericPin" />
                <PasswordBox x:Name="NewPin2" x:Uid="NewPin2" InputScope="NumericPin" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
