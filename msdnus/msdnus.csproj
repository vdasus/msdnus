<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>msdnus</RootNamespace>
    <UseWinUILibrary>true</UseWinUILibrary>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <DefaultLanguage>en-US</DefaultLanguage>
    <EnableMsixTooling>true</EnableMsixTooling>
    <PackageCertificateKeyFile>msdnus_StoreKey.pfx</PackageCertificateKeyFile>
    <PackageCertificateThumbprint>D082DDB8F24F09DD4433EE19D481B38176971753</PackageCertificateThumbprint>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.0-experimental3" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.6901" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\msdnus.Core\msdnus.Core.csproj" />
  </ItemGroup>
</Project>