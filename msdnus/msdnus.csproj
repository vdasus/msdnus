<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>msdnus</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <Platforms>x64;x86;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <DefaultLanguage>en-US</DefaultLanguage>
    <EnableMsixTooling>true</EnableMsixTooling>
    <EnableDefaultPriItems>true</EnableDefaultPriItems>
    <PublishAot>false</PublishAot>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2.0.1</Version>
    <AssemblyVersion>2.0.1.0</AssemblyVersion>
    <!-- Embeds a Win32 icon resource into the unpackaged .exe (packaged builds get their icon from Package.appxmanifest tiles) -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <!-- Pass -p:UnpackagedRun=true to build a self-contained unpackaged app for the dev inner loop -->
    <WindowsPackageType Condition="'$(UnpackagedRun)' == 'true'">None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="'$(UnpackagedRun)' == 'true'">true</WindowsAppSDKSelfContained>
    <!-- Packaged and unpackaged builds must never share build artifacts (XBF/PRI resource paths differ) -->
    <IntermediateOutputPath Condition="'$(UnpackagedRun)' == 'true'">obj\unpackaged\$(Platform)\$(Configuration)\</IntermediateOutputPath>
    <OutputPath Condition="'$(UnpackagedRun)' == 'true'">bin\unpackaged\$(Platform)\$(Configuration)\</OutputPath>
    <!-- Single-file self-contained publish for the unpackaged distributable (one .exe, WinAppSDK natives self-extracted at first run) -->
    <PublishSingleFile Condition="'$(UnpackagedRun)' == 'true'">true</PublishSingleFile>
    <SelfContained Condition="'$(UnpackagedRun)' == 'true'">true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(UnpackagedRun)' == 'true'">true</IncludeNativeLibrariesForSelfExtract>
    <!-- Compress the embedded payload (~100 MB smaller). Requires self-contained; first launch is slightly slower. -->
    <EnableCompressionInSingleFile Condition="'$(UnpackagedRun)' == 'true'">true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(UnpackagedRun)' == 'true'">none</DebugType>
    <DebugSymbols Condition="'$(UnpackagedRun)' == 'true'">false</DebugSymbols>
    <!-- Don't copy .pdb of referenced projects (e.g. msdnus.Core) into the single-file output -->
    <AllowedReferenceRelatedFileExtensions Condition="'$(UnpackagedRun)' == 'true'">none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.6901" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.86.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\msdnus.Core\msdnus.Core.csproj" />
  </ItemGroup>

</Project>