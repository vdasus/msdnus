<Page
    x:Class="msdnus.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:msdnus"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock x:Uid="appname" Grid.Row="0" Style="{ThemeResource HeaderTextBlockStyle}"  Height="Auto"  Margin="10 0 0 10" />

        <StackPanel Margin="15" Grid.Row="1">
            <ToggleSwitch x:Uid="IsDarkTheme" x:Name="IsDarkTheme" Margin="0 0 0 16" Header="Dark theme" IsOn="{x:Bind Vm.IsDarkTheme, Mode=TwoWay}" Toggled="ToggleSwitch_Toggled" />
            <PasswordBox x:Uid="enterpin" x:Name="Iejimo1" HorizontalContentAlignment="Center" 
                     HorizontalAlignment="Left" 
                     VerticalAlignment="Top" Width="222" Password="" PasswordChanged="PasswordChangedHandler"
                     PreventKeyboardDisplayOnProgrammaticFocus="False">
            <PasswordBox.InputScope>
                <InputScope>
                    <InputScope.Names>
                        <InputScopeName NameValue="NumericPin"/>
                    </InputScope.Names>
                </InputScope>
            </PasswordBox.InputScope>
        </PasswordBox>
            <PasswordBox x:Uid="enterpin2" x:Name="Iejimo2" HorizontalContentAlignment="Center" Margin="0 12 0 0" 
                         HorizontalAlignment="Left" 
                         VerticalAlignment="Top" Width="222" Password="" PasswordChanged="PasswordChangedHandler"
                         PreventKeyboardDisplayOnProgrammaticFocus="False">
            <PasswordBox.InputScope>
                <InputScope>
                    <InputScope.Names>
                        <InputScopeName NameValue="NumericPin"/>
                    </InputScope.Names>
                </InputScope>
            </PasswordBox.InputScope>
        </PasswordBox>
            <TextBlock Text="{x:Bind Vm.StatusErrText, Mode=OneWay}" Foreground="Red" />
            <Button x:Uid="savepin" Content="Save new PIN" Command="{x:Bind Vm.SaveIejimoParamCommand, Mode=OneTime}" Margin="0 16 0 0" />
        </StackPanel>
    </Grid>
</Page>







