<Application
    x:Class="msdnus.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:msdnus.ViewModel"
    xmlns:shared="using:msdnus.Shared">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <shared:BoolToVisibleConverter x:Key="BoolToVisConverter" />
            <shared:InverseBoolToVisibleConverter x:Key="InvBoolToVisConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
